# Copy to .env and replace every placeholder with local values.
# Never commit .env or use these placeholders in a shared/production environment.

# Generate a unique random value of at least 32 bytes for JWT signing.
JWT_SECRET=replace-with-a-unique-random-secret-at-least-32-bytes
DB_PASSWORD=replace-with-a-strong-local-database-password

# Required when starting the Compose monitoring profile.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-unique-long-random-password

# Optional integration settings; configure only when using these integrations.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
APP_FCM_CREDENTIALS_PATH=
