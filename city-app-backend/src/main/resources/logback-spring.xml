<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!--
        STRUCTURED JSON LOGGING

        WHY JSON LOGS:
        Plain text log: "2025-01-15 14:32:01 ERROR Order failed: orderId=1001"
        JSON log: {"timestamp":"2025-01-15T14:32:01Z","level":"ERROR",
                   "traceId":"abc123","orderId":"1001","message":"Order failed"}

        JSON logs: Loki can filter by field (level="ERROR"), by orderId, by traceId.
        Plain text: only grep (slow, no structure, cross-field queries impossible).

        With JSON: "show all logs for traceId abc123 across all services" = 1 Loki query.
        Without JSON: "grep abc123 across all log files on all servers" = painful.

        TWO APPENDERS:
        - CONSOLE: human-readable for local development
        - JSON_FILE: machine-readable for Loki in production

        Profile selection:
        - dev profile: CONSOLE appender (readable in terminal)
        - prod profile: JSON_FILE appender (Loki-compatible)
    -->

    <!-- Include Spring Boot's default configuration -->
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <!-- Properties -->
    <springProperty scope="context" name="appName"
                    source="spring.application.name"
                    defaultValue="city-app"/>
    <springProperty scope="context" name="activeProfile"
                    source="spring.profiles.active"
                    defaultValue="default"/>

    <!-- ── CONSOLE APPENDER (human-readable for dev) ─────────────────────── -->
    <appender name="CONSOLE"
              class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>
                %clr(%d{HH:mm:ss.SSS}){faint} %clr(%5p) %clr(${PID:- }){magenta}
                %clr(---){faint} %clr([%15.15t]){faint} %clr(%-40.40logger{39}){cyan}
                %clr(:){faint} %m%n%wEx
            </pattern>
            <!-- Same as Spring Boot default. Colours, class names, clean. -->
        </encoder>
    </appender>

    <!-- ── JSON APPENDER (Loki-compatible for production) ───────────────────
         Outputs JSON logs that Promtail can parse and send to Loki.
         Each log line is a JSON object with structured fields.
    -->
    <appender name="JSON_CONSOLE"
              class="ch.qos.logback.core.ConsoleAppender">
        <encoder
                class="net.logstash.logback.encoder.LogstashEncoder">
            <!--
                LogstashEncoder: produces JSON log lines.
                Includes: timestamp, level, logger, message, stack_trace.
                ALSO includes: MDC (Mapped Diagnostic Context) fields.
                MDC fields are set by Micrometer Tracing:
                  traceId, spanId (from B3 propagation)
                We add our own MDC fields:
                  userId, orderId, storeId (set in service methods)
            -->
            <customFields>
                {"app":"${appName}","env":"${activeProfile}"}
            </customFields>
            <fieldNames>
                <timestamp>timestamp</timestamp>
                <level>level</level>
                <message>message</message>
                <logger>logger</logger>
                <thread>thread</thread>
                <stackTrace>stack_trace</stackTrace>
            </fieldNames>
            <throwableConverter
                    class="net.logstash.logback.stacktrace.ShortenedThrowableConverter">
                <maxDepthPerCause>10</maxDepthPerCause>
                <shortenedClassNameLength>30</shortenedClassNameLength>
                <rootCauseFirst>true</rootCauseFirst>
            </throwableConverter>
        </encoder>
    </appender>

    <!-- ── FILE APPENDER (for Promtail to tail) ──────────────────────────── -->
    <appender name="JSON_FILE"
              class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/application.log</file>
        <rollingPolicy
                class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>logs/application.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>7</maxHistory>
            <!-- Keep 7 days of logs. Loki stores them longer. -->
        </rollingPolicy>
        <encoder
                class="net.logstash.logback.encoder.LogstashEncoder">
            <customFields>{"app":"${appName}","env":"${activeProfile}"}</customFields>
        </encoder>
    </appender>

    <!-- ── ASYNC WRAPPER ─────────────────────────────────────────────────────
         WHY ASYNC:
         Log writing is synchronous by default. Each log.info() call:
         formats the message, writes to file, flushes.
         At 10,000 requests/minute: 10,000 synchronous file writes per minute.
         Each write: 1-5ms. Total: 10-50 seconds/minute IN LOG WRITES.

         Async appender: log messages queued in memory.
         Background thread: flushes the queue to the file.
         Your application thread: returns immediately after enqueueing.
         Log writing overhead: near zero.

         Trade-off: if the app crashes with a full queue, some log messages are lost.
         For debugging: acceptable. For audit logs (payments): use sync.
    -->
    <appender name="ASYNC_JSON"
              class="ch.qos.logback.classic.AsyncAppender">
        <queueSize>1024</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <!-- discardingThreshold=0: don't discard any messages even when queue is full -->
        <appender-ref ref="JSON_FILE"/>
    </appender>

    <!-- ── PROFILE-BASED ACTIVATION ──────────────────────────────────────── -->

    <!-- Development: human-readable console -->
    <springProfile name="dev">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="ASYNC_JSON"/>
        </root>
        <logger name="com.cityapp" level="DEBUG"/>
        <logger name="org.hibernate.SQL" level="DEBUG"/>
        <logger name="org.springframework.security" level="DEBUG"/>
    </springProfile>

    <!-- Production: JSON logs for Loki -->
    <springProfile name="prod,kubernetes">
        <root level="INFO">
            <appender-ref ref="ASYNC_JSON"/>
        </root>
        <logger name="com.cityapp" level="INFO"/>
        <!-- Reduce noise in production -->
        <logger name="org.hibernate.SQL" level="WARN"/>
        <logger name="org.springframework.security" level="WARN"/>
    </springProfile>

    <!-- Docker profile: human-readable console -->
    <springProfile name="docker">
        <root level="DEBUG">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="ASYNC_JSON"/>
        </root>
        <logger name="com.cityapp" level="DEBUG"/>
        <logger name="org.hibernate.SQL" level="DEBUG"/>
        <logger name="org.springframework.security" level="DEBUG"/>
    </springProfile>

    <!-- Default (when no profile specified) -->
    <springProfile name="default">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>

</configuration>
